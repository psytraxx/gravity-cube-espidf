menu "Gravity cube"

config CUBE_LED_GPIO
    int "LED data GPIO"
    default 2
    help
        Data line of the WS2812 chain, through a 74AHCT125 level shifter
        and a 330 ohm series resistor. GPIO 2 is WLED's default LED pin on
        the ESP32. It is also a boot strapping pin: it must not be pulled
        high while the chip resets into download mode, which a level
        shifter input does not do.

config CUBE_FRAME_MS
    int "Physics step period (ms)"
    default 12
    range 5 100
    help
        One physics step per period. The physics constants are per step,
        so a longer period slows the fluid down. 12 ms is the rate the LED
        chain can be refreshed at (384 LEDs take ~11.5 ms).

config CUBE_TAP_THRESHOLD_MG
    int "Tap threshold (mg)"
    default 1000
    range 300 4000
    help
        Jump in acceleration between two samples (4 ms apart) that counts
        as a tap. Raise it if sloshing the fluid switches effects, lower it
        if double taps are missed.

config CUBE_IMU_SPI_MOSI
    int "SPI MOSI GPIO (board SDA/SDI)"
    default 23

config CUBE_IMU_SPI_MISO
    int "SPI MISO GPIO (board AD0/SDO)"
    default 19

config CUBE_IMU_SPI_SCLK
    int "SPI SCLK GPIO (board SCL)"
    default 18

config CUBE_IMU_SPI_CS
    int "SPI CS GPIO (board NCS)"
    default 5

endmenu
